# --- Base de données (Supabase Postgres) ---
# Dashboard Supabase → Connect → onglet ORM/Prisma. Encode les caractères
# spéciaux du mot de passe dans l'URL (ex. « % » → « %25 »).
# DATABASE_URL : pooler transactionnel (port 6543, ?pgbouncer=true) — runtime.
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL : connexion directe (session pooler, port 5432) — CLI Prisma/migrations.
DIRECT_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Authentification ---
# Générer une clé : openssl rand -base64 32
AUTH_SECRET="change-me-with-a-32-bytes-random-secret"

# --- API Claude (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Moteurs IA réels (facultatif : sans clé, l'app retombe sur l'estimation Claude) ---
# La niche est d'abord détectée par Claude, puis on interroge les moteurs avec
# une requête « top 10 » grand public (aucun system prompt) pour MESURER le rang.
# OpenAI — Responses API + web_search (contexte « high »), comme ChatGPT web
OPENAI_API_KEY="sk-proj-..."
# OPENAI_MODEL="gpt-5.5"
# Google Gemini — grounding Google Search, comme Gemini Flash grand public
GEMINI_API_KEY="AQ...."
# GEMINI_MODEL="gemini-flash-latest"
# Perplexity — modèle sonar, recherche web par construction
PERPLEXITY_API_KEY="pplx-..."
# PERPLEXITY_MODEL="sonar"
# Claude — outil web_search (réutilise ANTHROPIC_API_KEY ci-dessus)
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Offres Stripe (mode test). Accepte un Price ID (price_...) OU un Product ID
# (prod_...) : dans ce dernier cas, le default_price du produit est utilisé.
# UNIT = offre transactionnelle (paiement unique) · AGENCY = abonnement mensuel.
STRIPE_PRICE_UNIT="prod_..."
STRIPE_PRICE_AGENCY="prod_..."

# --- Captures d'écran (ApiFlash) ---
# Clé d'accès ApiFlash (https://apiflash.com). Servie côté serveur via /api/screenshot
# (jamais exposée au client). Sans clé, l'app retombe sur l'aperçu mShots.
API_FLASH_KEY="..."

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- DataForSEO (mentions dans les IA) ---
# Identifiants API : https://app.dataforseo.com/api-access
# Sans eux, la carte « Mentions dans les IA » du tableau de bord reste en
# mode exemple et aucun appel facturé ne part.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Variante à variable unique : base64 de « login:password ».
# DATAFORSEO_AUTH=

# --- Rattachement des sites clients (WordPress, Shopify, Ghost…) ---
# Chiffre au repos les identifiants de plateforme (AES-256-GCM, lib/crypto).
# 32 caractères au minimum. Générer : openssl rand -base64 32
# Sans elle, le serveur refuse tout rattachement.
# ATTENTION : la changer rend illisibles tous les liens déjà enregistrés — les
# clients devraient se rattacher à nouveau, un par un.
CREDENTIALS_KEY="change-me-with-a-32-bytes-random-secret"

# --- Tâche planifiée de publication ---
# Ferme /api/cron/publish, qui publie les articles arrivés à échéance.
# Vercel envoie ce secret lui-même, en en-tête Authorization, dès qu'il est
# défini sur le projet. Sans lui, la route répond 503 et rien ne part.
# Générer : openssl rand -base64 32
CRON_SECRET="change-me-with-a-32-bytes-random-secret"
